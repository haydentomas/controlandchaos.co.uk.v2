  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture-templates.mjs",
    "render": "node scripts/render-templates.mjs",
    "test": "npm run render && node --test scripts/templates.test.mjs scripts/page-shell.test.mjs scripts/database.test.mjs scripts/directory.test.mjs scripts/auth.test.mjs scripts/account-recovery.test.mjs scripts/avatar-verification.test.mjs scripts/directory-payment.test.mjs scripts/terminal-login.test.mjs scripts/creator-profile.test.mjs scripts/blog-attachments.test.mjs scripts/directory-reminders.test.mjs scripts/booking-request.test.mjs scripts/rich-text.test.mjs",
    "test:rich-text": "npm run render && node --test scripts/rich-text.test.mjs scripts/rich-text.browser.test.mjs",
    "test:reminders": "node --test scripts/directory-reminders.test.mjs",
    "test:creator": "node --test scripts/creator-profile.test.mjs scripts/database.test.mjs scripts/blog-attachments.test.mjs",
    "test:blog:browser": "npm run render && node --test scripts/creator-blog.browser.test.mjs",
    "test:terminal-login": "node --test scripts/terminal-login.test.mjs scripts/auth.test.mjs",
    "test:payments": "node --test scripts/directory-payment.test.mjs scripts/database.test.mjs",
    "test:verification": "node --test scripts/avatar-verification.test.mjs",
    "test:auth": "node --test scripts/auth.test.mjs scripts/account-recovery.test.mjs",
    "test:auth:browser": "npm run render && node --test scripts/auth.browser.test.mjs",
    "test:directory": "node --test scripts/directory.test.mjs",
    "test:db": "node --test scripts/database.test.mjs",
    "test:visual": "node scripts/visual-audit.mjs",
    "dev": "vite",
    "cms:local": "node scripts/start-cms.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decap-server": "3.11.3",
    "linkedom": "^0.18.13",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "sanitize-html": "2.18.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "@supabase/supabase-js": "2.117.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "nunjucks": "3.2.4"
  },
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "$dompurify"
    }
  }
}
