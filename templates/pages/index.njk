{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- ================================================================= -->
  <!-- HERO SECTION: SHOUTING ABOUT THE ECOSYSTEM & ENGAGING USERS -->
  <!-- ================================================================= -->
  <header class="hero">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>👑 SECOND LIFE'S PREMIER GAMIFIED FINDOM SANCTUARY</span>
      </div>

      <h1 class="hero-title hero-title-responsive">
        MAKING FINDOM FUN AGAIN.<br>
        <span class="gold-gradient-text">EARN XP. LEVEL UP. SERVE IN LUXURY.</span>
      </h1>

      <p class="hero-description hero-desc-lead">
        Step into Second Life's ultimate interactive FinDom playground. Earn XP for chatting, socialising, and playing arcade games, climb 50 progressive DOM &amp; SUB ranks, stack Gold Coins for exclusive perks, and serve registered Dominants in breathtaking luxury venues.
      </p>

      <div class="hero-cta hero-cta-group">
        <a href="/xp-system" class="btn btn-gold btn-lg">
          <span>🏆</span> Explore The XP System
        </a>
        <a href="/products" class="btn btn-secondary btn-lg">
          <span>🛍️</span> BDSM &amp; FinDom Store
        </a>
        <a href="http://maps.secondlife.com/secondlife/Los%20Pengos/97/181/3000" target="_blank" rel="noopener" class="btn btn-secondary btn-lg">
          <span>📍</span> Visit Us In-World
        </a>
      </div>

      <!-- Quick Trust & Feature Badges -->
      <div class="hero-stats-ribbon">
        <div class="hero-stat-pill">⚡ <strong>50 Progressive Ranks</strong> (DOM &amp; SUB)</div>
        <div class="hero-stat-pill">✨ <strong>100% Free</strong> Cloud-Synced Experience</div>
        <div class="hero-stat-pill">👑 <strong>Active In-World</strong> Dominants</div>
        <div class="hero-stat-pill">🪙 <strong>Instant Gold Coin</strong> Rewards</div>
      </div>
    </div>
  </header>

  <!-- ================================================================= -->
  <!-- 1. THE XP & LEVELING ECOSYSTEM (FIRST!) -->
  <!-- ================================================================= -->
  <section class="section section-surface-1">
    <div class="container">
      <div class="section-header">
        <span class="step-number-badge">1. THE GAMIFIED SIM ECONOMY</span>
        <h2 class="section-title section-title-lg">Play, Socialize &amp; Climb 50 Ranks</h2>
        <p class="section-subtitle">
          Forget static, transactional tip jars. Our custom LSL Experience Cloud turns every interaction on the estate into measurable progression, prestige titles, and spendable Gold Coins.
        </p>
      </div>

      <div class="grid-4 mb-36">
        
        <!-- Pillar 1: Chat & RP -->
        <div class="card card-flex-column">
          <div class="card-icon">💬</div>
          <h3 class="card-title">Chat &amp; Social Sitting</h3>
          <p class="card-desc card-body-grow">
            Earn <strong>+2 to +4 XP</strong> chatting in local or writing roleplay emotes, plus passive XP lounging in the Ballroom radar.
          </p>
          <span class="card-meta-pill">⚡ +2 to +4 XP per 90s</span>
        </div>

        <!-- Pillar 2: Greedy & Merge -->
        <div class="card card-flex-column">
          <div class="card-icon">🎲</div>
          <h3 class="card-title">Greedy Dice &amp; Merge Arcades</h3>
          <p class="card-desc card-body-grow">
            Play integrated Second Life Greedy tables and Darkmoon puzzle cabinets for massive XP pots and Gold Coin payouts.
          </p>
          <span class="card-meta-pill">🎮 Up to 250 XP / game</span>
        </div>

        <!-- Pillar 3: Sim Coin Hunts -->
        <div class="card card-flex-column">
          <div class="card-icon">🪙</div>
          <h3 class="card-title">Sim-Wide Coin Hunts</h3>
          <p class="card-desc card-body-grow">
            Discover hidden chests, mystery multipliers, and glowing gold coins refreshing every 3 hours across the parcel.
          </p>
          <span class="card-meta-pill">✨ +1 to +50 Coins</span>
        </div>

        <!-- Pillar 4: Tribute Jars -->
        <div class="card card-flex-column">
          <div class="card-icon">🏺</div>
          <h3 class="card-title">Tribute Matching &amp; Quests</h3>
          <p class="card-desc card-body-grow">
            Every Linden Dollar (L$) paid into a Domme's Tribute Jar instantly matches 1:1 in leveling XP for both partners.
          </p>
          <span class="card-meta-pill">💎 1:1 Instant XP Match</span>
        </div>

      </div>

      <!-- Factions CTA Card -->
      <div class="callout-banner-box">
        <div class="callout-banner-content">
          <span class="section-tag manifesto-tag">CHOOSE YOUR FACTION</span>
          <h3>DOM Faction vs. SUB Faction</h3>
          <p>
            Climb from Initiate to Sovereign (DOM) or Aspirant to Icon (SUB). Unlock custom particle footstep trails, arrival fanfare broadcasts, VIP lounge keys, and Prestige resets at Level 50.
          </p>
        </div>
        <a href="/xp-system" class="btn btn-gold btn-lg">
          <span>🏆</span> View Game Guide →
        </a>
      </div>

    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 2. RETAIL STORE & HARDWARE TECH (SECOND!) -->
  <!-- ================================================================= -->
  <section class="section section-surface-2">
    <div class="container">
      <div class="section-header">
        <span class="step-number-badge">2. HARDWARE &amp; RETAIL TECH</span>
        <h2 class="section-title section-title-lg">BDSM, FinDom &amp; Companion Hardware</h2>
        <p class="section-subtitle">
          Engineered with Mono 64-bit low-lag scripts, Bento mesh props, and complete Second Life Experience auto-syncing.
        </p>
      </div>

      <div class="grid-2 mb-36">
        
        <!-- Featured Product 1: Vow Collar -->
        <div class="card card-highlight-gold p-32 card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/vow-collar.jpg" alt="[C&C] Vow Collar 2026 & Domme HUD">
          </div>
          <div class="flex-between align-start mb-12">
            <span class="section-tag tag-burgundy">FLAGSHIP HARDWARE</span>
            <span class="card-price-badge">L$2,499</span>
          </div>
          <h3 class="product-title">[C&amp;C] Vow Collar 2026 &amp; Domme HUD</h3>
          <p class="card-desc card-body-grow mb-16">
            The definitive BDSM, Financial Domination, and RLV management suite. Features native in-collar air taxes, auto-debit, stealth mesh props (ballgags, snouts), multi-sim GPS tracking, and a lag-free native Domme HUD.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-vow-collar" class="btn btn-gold btn-sm">Read User Manual →</a>
            <a href="/products" class="btn btn-secondary btn-sm">Store Page</a>
          </div>
        </div>

        <!-- Featured Product 2: PocketPig Companion -->
        <div class="card p-32 card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/pocket-pig.jpg" alt="[C&C] PocketPig Companion HUD">
          </div>
          <div class="flex-between align-start mb-12">
            <span class="section-tag manifesto-tag">INTERACTIVE COMPANION</span>
            <span class="card-price-badge">L$899</span>
          </div>
          <h3 class="product-title">[C&amp;C] PocketPig Companion HUD</h3>
          <p class="card-desc card-body-grow mb-16">
            Screen HUD and animated Bento snout prop. Features hunger/energy stamina meters, public tribute commands, smart oinking animations, and direct pairing with the Vow Collar.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-pocket-pig" class="btn btn-gold btn-sm">Read User Manual →</a>
            <a href="/products" class="btn btn-secondary btn-sm">Store Page</a>
          </div>
        </div>

      </div>

      <!-- Quick Store Banner -->
      <div class="text-center">
        <a href="/products" class="btn btn-gold btn-lg">
          <span>🛍️</span> Visit Our Store →
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 3. TOURNAMENTS & SIM EVENTS (THIRD!) -->
  <!-- ================================================================= -->
  <section class="section section-surface-3">
    <div class="container">
      <div class="section-header">
        <span class="step-number-badge">3. LIVE IN-WORLD ACTION</span>
        <h2 class="section-title section-title-lg">Tournaments, Galas &amp; Double XP</h2>
        <p class="section-subtitle">
          Join high-energy weekly championships, formal black-tie galas, and live trivia competitions in Second Life.
        </p>
      </div>

      <div class="grid-2 mb-32">
        
        <!-- Event 1: Cage Break -->
        <div class="card p-28 card-flex-column">
          <div class="flex-between mb-12">
            <span class="section-tag font-2xs m-0">TOURNAMENT</span>
            <span class="font-mono font-xs text-gold">Every Saturday • 1:00 PM SLT</span>
          </div>
          <h3 class="card-title font-md mb-8">⚡ Cage Break Championship</h3>
          <p class="card-desc card-body-grow mb-16">
            High-octane cybernetic laser arena battles. Submissives hack laser lockpads while Dominants defend containment. Double XP, Gold Coin pots, and championship titles awarded.
          </p>
          <div class="card-actions-bar">
            <a href="/events" class="btn btn-gold btn-sm">Add to Calendar →</a>
            <a href="/xp-system#how-to-earn" class="btn btn-secondary btn-sm">Event Rules</a>
          </div>
        </div>

        <!-- Event 2: Luxury Gala -->
        <div class="card p-28 card-flex-column">
          <div class="flex-between mb-12">
            <span class="section-tag font-2xs m-0">LUXURY GALA</span>
            <span class="font-mono font-xs text-gold">Friday • 6:00 PM SLT</span>
          </div>
          <h3 class="card-title font-md mb-8">👑 High Society FinDom Gala</h3>
          <p class="card-desc card-body-grow mb-16">
            Formal black-tie gala at Control &amp; Chaos Grand Ballroom. Features live DJ sets, couple dance spheres, champagne tribute fountains, and verified escort auctions.
          </p>
          <div class="card-actions-bar">
            <a href="/events" class="btn btn-gold btn-sm">Add to Calendar →</a>
            <a href="/directory" class="btn btn-secondary btn-sm">View Companions</a>
          </div>
        </div>

      </div>

      <div class="text-center">
        <a href="/events" class="btn btn-secondary">
          <span>📅</span> View Complete Events Calendar →
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 4. REGISTERED DOMINANTS DIRECTORY (FOURTH!) -->
  <!-- ================================================================= -->
  <section class="section section-surface-dark">
    <div class="container">
      <div class="section-header">
        <span class="step-number-badge">4. ACTIVE IN-WORLD PLAYERS</span>
        <h2 class="section-title section-title-lg">Control &amp; Chaos Registered Dominants</h2>
        <p class="section-subtitle">
          These verified Dominants are active players on the estate holding court and leading factions. Submissives are welcome to explore their rate cards, pay homage at their tribute jars, or contact them directly for sessions and service.
        </p>
      </div>

      <div class="grid-3 mb-32">
        
        <!-- Dom 1: Mistress Alexis Vane -->
        <div class="dom-rate-card">
          <div>
            <div class="flex-between align-center mb-14">
              <span class="dom-role-badge">
                DOMINANT
              </span>
              <span class="dom-handle">
                @alek.zane
              </span>
            </div>
            <h3 class="dom-name">
              Mistress Alexis Vane
            </h3>
            <p class="dom-quote">
              "Unapologetic luxury, exquisite psychological draining, and high-society accompaniment."
            </p>
          </div>
          <div class="dom-rate-footer">
            <div class="dom-rate-price">
              From L$2,500 / hr
            </div>
            <a href="/profile" class="dom-rate-pill">
              RATE CARD →
            </a>
          </div>
        </div>

        <!-- Dom 2: Lady Seraphina Noir -->
        <div class="dom-rate-card">
          <div>
            <div class="flex-between align-center mb-14">
              <span class="dom-role-badge">
                DOMINANT
              </span>
              <span class="dom-handle">
                @seraphina.noir
              </span>
            </div>
            <h3 class="dom-name">
              Lady Seraphina Noir
            </h3>
            <p class="dom-quote">
              "Sensory deprivation, voice whisper hypnosis, and uncompromising posture discipline."
            </p>
          </div>
          <div class="dom-rate-footer">
            <div class="dom-rate-price">
              From L$2,000 / hr
            </div>
            <a href="/profile" class="dom-rate-pill">
              RATE CARD →
            </a>
          </div>
        </div>

        <!-- Dom 3: Master Damien Cross -->
        <div class="dom-rate-card">
          <div>
            <div class="flex-between align-center mb-14">
              <span class="dom-role-badge">
                DOMINANT
              </span>
              <span class="dom-handle">
                @damien.cross
              </span>
            </div>
            <h3 class="dom-name">
              Master Damien Cross
            </h3>
            <p class="dom-quote">
              "Refined male dominance, dark romance, and behavioral protocol calibration."
            </p>
          </div>
          <div class="dom-rate-footer">
            <div class="dom-rate-price">
              From L$1,800 / hr
            </div>
            <a href="/profile" class="dom-rate-pill">
              RATE CARD →
            </a>
          </div>
        </div>

      </div>

      <div class="text-center">
        <a href="/directory" class="btn btn-gold">
          <span>👑</span> Browse Directory →
        </a>
      </div>
    </div>
  </section>

  <!-- ================================================================= -->
  <!-- 5. CONTACT US & IN-WORLD CONCIERGE (FIFTH!) -->
  <!-- ================================================================= -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="step-number-badge">5. GET IN TOUCH</span>
        <h2 class="section-title section-title-lg">Visit Us In-World or Contact Us</h2>
        <p class="section-subtitle">
          Have questions about joining the sim, registering your Domme profile, or configuring your Vow Collar? Our team is available in Second Life and Discord.
        </p>
      </div>

      <div class="grid-3 mb-36">
        
        <!-- Contact Block 1: Alek & Lexi Direct -->
        <div class="card p-28">
          <div class="card-icon">👑</div>
          <h3 class="card-title font-md">Executive Management</h3>
          <p class="card-desc mb-14">
            Direct inquiries for estate partnerships, VIP skybox leases, and custom hardware orders.
          </p>
          <div class="font-mono font-xs text-gold line-relaxed">
            • <strong>Alek Zane</strong>: <code>alek.zane</code><br>
            • <strong>Lexi Zane</strong>: <code>lexi.zane</code>
          </div>
        </div>

        <!-- Contact Block 2: In-World Sim Teleport -->
        <div class="card card-highlight-gold p-28 text-center card-flex-between">
          <div>
            <div class="font-3xl mb-8">📍</div>
            <h3 class="card-title font-md">Control &amp; Chaos</h3>
            <p class="card-desc mb-16">
              Arrive directly at the main arrival terminal, pick your faction, and start playing immediately.
            </p>
          </div>
          <a href="http://maps.secondlife.com/secondlife/Los%20Pengos/97/181/3000" target="_blank" rel="noopener" class="btn btn-gold w-100">
            Teleport In-World →
          </a>
        </div>

        <!-- Contact Block 3: Contact Us & Form -->
        <div class="card p-28 card-flex-between">
          <div>
            <div class="card-icon">✉️</div>
            <h3 class="card-title font-md">Contact Us</h3>
            <p class="card-desc mb-16">
              Send a quick message, report an issue, or request assistance from our team.
            </p>
          </div>
          <a href="/contact" class="btn btn-secondary w-100">
            Contact Us →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
