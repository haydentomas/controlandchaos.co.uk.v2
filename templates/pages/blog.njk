{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- News Hero -->
  <header class="hero tw:[min-height:50vh] tw:[padding:120px_0_50px]">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>COMMUNITY FEED • TOURNAMENTS • CHANGELOG</span>
      </div>
      <h1 class="hero-title tw:[font-size:46px]">
        DISPATCHES FROM <span class="gold-gradient-text">CONTROL &amp; CHAOS</span>
      </h1>
      <p class="hero-description">
        Read the latest updates on sim tournaments, double XP weekends, economy balance patches, and new hardware releases.
      </p>
    </div>
  </header>

  <!-- Blog / Posts Section -->
  <section class="section">
    <div class="container">
      
      <!-- Filters -->
      <div class="tw:[display:flex] tw:[justify-content:space-between] tw:[align-items:center] tw:[gap:16px] tw:[margin-bottom:36px] tw:[flex-wrap:wrap]">
        <input class="blog-input-presentation" type="text" placeholder="Search news and patch notes...">
        
        <div class="tw:[display:flex] tw:[gap:8px] tw:[flex-wrap:wrap]">
          <button class="btn btn-gold btn-sm active-cat" data-cat="all">All</button>
          <button class="btn btn-secondary btn-sm" data-cat="Product Launch">Products</button>
          <button class="btn btn-secondary btn-sm" data-cat="Sim Event">Events</button>
          <button class="btn btn-secondary btn-sm" data-cat="Economy Update">Economy</button>
          <button class="btn btn-secondary btn-sm" data-cat="Patch Notes">Patches</button>
        </div>
      </div>

      <!-- Posts Grid -->
      <div class="grid-2"><div class="card">
            
            <a class="blog-a-presentation" href="/blog-vow-launch.html">
              <img class="tw:[width:100%] tw:[height:100%] tw:[object-fit:cover] tw:[transition:transform_0.3s_ease]" src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80" alt="Vow Collar 2026 Standalone Edition Release">
            </a>
          
            <div class="tw:[display:flex] tw:[justify-content:space-between] tw:[align-items:center] tw:[margin-bottom:10px]">
              <span class="section-tag tw:[margin:0] tw:[font-size:9.5px] tw:[padding:2px_8px]">Product Launch</span>
              <span class="tw:[font-family:var(--font-mono)] tw:[font-size:11px] tw:[color:var(--gold-muted)]">October 2026 • Architect of Chaos</span>
            </div>
            <h3 class="card-title tw:[font-size:20px] tw:[margin-bottom:10px] tw:[line-height:1.4]">
              <a class="tw:[color:#fff] tw:[text-decoration:none]" href="/blog-vow-launch.html">Vow Collar 2026 Standalone Edition Release</a>
            </h3>
            <p class="tw:[font-size:14px] tw:[color:#b0b0c5] tw:[line-height:1.6] tw:[margin-bottom:18px] tw:[flex:1]">The definitive BDSM, FinDom, and RLV management collar has completed QA testing and is now entering in-world release.</p>
            <div class="tw:[border-top:1px_solid_rgba(255,255,255,0.06)] tw:[padding-top:14px] tw:[margin-top:auto]">
              <a href="/blog-vow-launch.html" class="btn btn-secondary btn-sm tw:[width:100%] tw:[justify-content:center]">
                Read Full Post →
              </a>
            </div>
          </div><div class="card">
            
            <a class="blog-a-presentation" href="/blog-cage-break-xp.html">
              <img class="tw:[width:100%] tw:[height:100%] tw:[object-fit:cover] tw:[transition:transform_0.3s_ease]" src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80" alt="Cage Break Arena: Double XP Weekend Event">
            </a>
          
            <div class="tw:[display:flex] tw:[justify-content:space-between] tw:[align-items:center] tw:[margin-bottom:10px]">
              <span class="section-tag tw:[margin:0] tw:[font-size:9.5px] tw:[padding:2px_8px]">Sim Event</span>
              <span class="tw:[font-family:var(--font-mono)] tw:[font-size:11px] tw:[color:var(--gold-muted)]">October 2026 • Architect of Chaos</span>
            </div>
            <h3 class="card-title tw:[font-size:20px] tw:[margin-bottom:10px] tw:[line-height:1.4]">
              <a class="tw:[color:#fff] tw:[text-decoration:none]" href="/blog-cage-break-xp.html">Cage Break Arena: Double XP Weekend Event</a>
            </h3>
            <p class="tw:[font-size:14px] tw:[color:#b0b0c5] tw:[line-height:1.6] tw:[margin-bottom:18px] tw:[flex:1]">Join us this Friday through Sunday for high-stakes prisoner rescue battles with double XP and bonus Gold Coin rewards.</p>
            <div class="tw:[border-top:1px_solid_rgba(255,255,255,0.06)] tw:[padding-top:14px] tw:[margin-top:auto]">
              <a href="/blog-cage-break-xp.html" class="btn btn-secondary btn-sm tw:[width:100%] tw:[justify-content:center]">
                Read Full Post →
              </a>
            </div>
          </div><div class="card">
            
            <a class="blog-a-presentation" href="/blog-profile-picks.html">
              <img class="tw:[width:100%] tw:[height:100%] tw:[object-fit:cover] tw:[transition:transform_0.3s_ease]" src="https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=1200&q=80" alt="New Weekly Loyalty Streak Rewards">
            </a>
          
            <div class="tw:[display:flex] tw:[justify-content:space-between] tw:[align-items:center] tw:[margin-bottom:10px]">
              <span class="section-tag tw:[margin:0] tw:[font-size:9.5px] tw:[padding:2px_8px]">Economy Update</span>
              <span class="tw:[font-family:var(--font-mono)] tw:[font-size:11px] tw:[color:var(--gold-muted)]">September 2026 • Architect of Chaos</span>
            </div>
            <h3 class="card-title tw:[font-size:20px] tw:[margin-bottom:10px] tw:[line-height:1.4]">
              <a class="tw:[color:#fff] tw:[text-decoration:none]" href="/blog-profile-picks.html">New Weekly Loyalty Streak Rewards</a>
            </h3>
            <p class="tw:[font-size:14px] tw:[color:#b0b0c5] tw:[line-height:1.6] tw:[margin-bottom:18px] tw:[flex:1]">Keep Control &amp; Chaos in your public Second Life profile picks to earn compounding weekly streak bonuses at the Main Terminal.</p>
            <div class="tw:[border-top:1px_solid_rgba(255,255,255,0.06)] tw:[padding-top:14px] tw:[margin-top:auto]">
              <a href="/blog-profile-picks.html" class="btn btn-secondary btn-sm tw:[width:100%] tw:[justify-content:center]">
                Read Full Post →
              </a>
            </div>
          </div><div class="card">
            
            <a class="blog-a-presentation" href="/blog-patch-v2-1.html">
              <img class="tw:[width:100%] tw:[height:100%] tw:[object-fit:cover] tw:[transition:transform_0.3s_ease]" src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1200&q=80" alt="Patch Notes: Cloud KVP Memory Optimization">
            </a>
          
            <div class="tw:[display:flex] tw:[justify-content:space-between] tw:[align-items:center] tw:[margin-bottom:10px]">
              <span class="section-tag tw:[margin:0] tw:[font-size:9.5px] tw:[padding:2px_8px]">Patch Notes</span>
              <span class="tw:[font-family:var(--font-mono)] tw:[font-size:11px] tw:[color:var(--gold-muted)]">September 2026 • Architect of Chaos</span>
            </div>
            <h3 class="card-title tw:[font-size:20px] tw:[margin-bottom:10px] tw:[line-height:1.4]">
              <a class="tw:[color:#fff] tw:[text-decoration:none]" href="/blog-patch-v2-1.html">Patch Notes: Cloud KVP Memory Optimization</a>
            </h3>
            <p class="tw:[font-size:14px] tw:[color:#b0b0c5] tw:[line-height:1.6] tw:[margin-bottom:18px] tw:[flex:1]">Performance enhancements across all sim terminals and venue bridges to eliminate script delay during peak club hours.</p>
            <div class="tw:[border-top:1px_solid_rgba(255,255,255,0.06)] tw:[padding-top:14px] tw:[margin-top:auto]">
              <a href="/blog-patch-v2-1.html" class="btn btn-secondary btn-sm tw:[width:100%] tw:[justify-content:center]">
                Read Full Post →
              </a>
            </div>
          </div></div>

      <!-- Load More Button -->
      <div class="tw:[text-align:center] tw:[margin-top:40px] tw:[display:none]">
        <button class="btn btn-gold">
          <span>📜</span> Load More Posts
        </button>
      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
