{% extends "layouts/site.njk" %}
{% block content %}
<header class="hero hero-compact">
  <canvas height="" width="" id="hero-canvas"></canvas>
  <div class="container">
    <h1 class="hero-title hero-title-subpage" data-public-profile-name>Profile</h1>
    <p class="hero-description" data-public-profile-headline></p>
  </div>
</header>
<main class="section">
  <div class="container">
    <p class="text-muted" data-public-profile-status role="status" aria-live="polite">Loading profile...</p>
    <div class="preview-hidden" data-public-profile-content>
      <div class="public-profile-overview">
        <img class="public-profile-avatar preview-hidden" data-public-profile-avatar alt="">
        <div>
          <span class="role-badge" data-public-profile-role></span>
          <p class="font-mono font-xs text-gold" data-public-profile-username></p>
          <p class="dom-quote" data-public-profile-tagline></p>
          <p class="text-gold font-bold" data-public-profile-rate></p>
          <div class="flex-row flex-wrap gap-8" data-public-profile-tags></div>
        </div>
      </div>
      <section class="section"><h2 class="section-title">About</h2><div class="public-profile-about" data-public-profile-about></div></section>
      <section class="section preview-hidden" data-public-profile-rate-section><h2 class="section-title">Rate Cards &amp; Menus</h2><div data-public-profile-rates></div></section>
    </div>
    <a href="/directory.html" class="btn btn-secondary btn-sm">&#8592; Directory</a>
  </div>
</main>
{% endblock %}