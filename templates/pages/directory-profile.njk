{% extends "layouts/site.njk" %}
{% block content %}
<header class="hero hero-compact">
  <canvas height="" width="" id="hero-canvas"></canvas>
  <div class="container">
    <h1 class="hero-title hero-title-subpage" data-public-profile-name>Profile</h1>
    <p class="hero-description" data-public-profile-headline></p>
    <img class="public-profile-banner preview-hidden" data-public-profile-banner alt="" referrerpolicy="no-referrer">
  </div>
</header>
<main class="section">
  <div class="container">
    <p class="text-muted" data-public-profile-status role="status" aria-live="polite">Loading profile...</p>
    <div class="preview-hidden" data-public-profile-content>
      <div class="public-profile-layout">
        <div class="public-profile-main">
          <section class="public-profile-panel public-profile-about-panel">
            <h2 class="public-profile-section-title">About</h2>
            <div class="public-profile-about" data-public-profile-about></div>
          </section>
          <section class="public-profile-panel preview-hidden" data-public-profile-rate-section>
            <h2 class="public-profile-section-title">Rate Cards &amp; Menus</h2>
            <div data-public-profile-rates></div>
          </section>
        </div>
        <aside class="public-profile-sidebar">
          <section class="public-profile-panel public-profile-summary">
            <div class="public-profile-overview">
              <img class="public-profile-avatar preview-hidden" data-public-profile-avatar alt="">
              <div class="public-profile-identity">
                <span class="role-badge" data-public-profile-role></span>
                <p class="font-mono font-xs text-gold" data-public-profile-username></p>
                <p class="dom-quote" data-public-profile-tagline></p>
                <p class="text-gold font-bold" data-public-profile-rate></p>
                <p class="text-gold public-profile-availability" data-public-profile-availability></p>
                <p class="text-muted" data-public-profile-availability-note></p>
                <div class="flex-row flex-wrap gap-8" data-public-profile-tags></div>
              </div>
            </div>
          </section>
          <section class="public-profile-panel preview-hidden" data-public-profile-booking-section>
            <h2 class="public-profile-section-title">Booking Hours</h2>
            <div class="public-booking-hours" data-public-profile-hours></div>
          </section>
        </div>
      </div>
      <section class="public-profile-panel public-profile-gallery preview-hidden" data-public-profile-gallery>
        <h2 class="public-profile-section-title">Gallery</h2>
        <p class="text-muted" data-public-gallery-status role="status"></p>
        <div class="account-actions" id="gallery-library-filters"></div>
        <div class="public-gallery-grid" id="gallery-library-grid"></div>
      </section>
    </div>
    <a href="/directory.html" class="btn btn-secondary btn-sm">&#8592; Directory</a>
  </div>
</main>
<div class="lightbox-modal" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" tabindex="-1">
  <div class="lightbox-content">
    <button type="button" id="lightbox-close" class="gallery-lightbox-control gallery-lightbox-close" title="Close" aria-label="Close photo viewer">&#215;</button>
    <button type="button" id="lightbox-previous" class="gallery-lightbox-control gallery-lightbox-previous" title="Previous image" aria-label="Previous image" hidden>&#8592;</button>
    <img src="" alt="Gallery preview" class="lightbox-img" id="lightbox-image" referrerpolicy="no-referrer">
    <button type="button" id="lightbox-next" class="gallery-lightbox-control gallery-lightbox-next" title="Next image" aria-label="Next image" hidden>&#8594;</button>
    <div class="public-lightbox-caption" id="lightbox-caption"></div><p id="lightbox-description" class="gallery-lightbox-description"></p><span id="lightbox-counter" class="gallery-lightbox-counter" aria-live="polite"></span>
  </div>
</div>
{% endblock %}