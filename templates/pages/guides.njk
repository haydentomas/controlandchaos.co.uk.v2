{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Guides Hero -->
  <header class="hero hero-compact">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>PRODUCT MANUALS • HOW-TO GUIDES • SETUP</span>
      </div>
      <h1 class="hero-title hero-title-subpage">
        PRODUCT MANUALS &amp; <span class="gold-gradient-text">USER GUIDES</span>
      </h1>
      <p class="hero-description">
        Access official documentation, channel command references, RLV settings, and setup walkthroughs for all Control &amp; Chaos hardware and scripted devices.
      </p>
    </div>
  </header>

  <!-- Product Guides Grid -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Official Documentation</span>
        <h2 class="section-title">Hardware &amp; Product Manuals</h2>
        <p class="section-subtitle">Select a product to view its complete operational manual, chat commands, and marketplace links.</p>
      </div>

      {% endraw %}
<div class="grid-3" data-manual-list>
{% for guide in guides %}{% include "partials/guide-card.njk" %}{% endfor %}
{% for guide in guides %}{% if guide.id == "vow-collar" %}
{% raw %}
<div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/vow-atm.jpg" alt="[C&C] Venue ATM Terminal">
          </div>
          <span class="section-tag manifesto-tag align-start mb-8">VENUE HARDWARE</span>
          <h3 class="card-title">[C&amp;C] Vow ATM Terminal</h3>
          <p class="card-desc card-body-grow">
            Rezzable venue terminal allowing guests to tribute registered house Dominants directly, earn loyalty points, and print tribute milestone certificates.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-vow-collar" class="btn btn-gold btn-sm card-body-grow">ATM Guide →</a>
            <a href="/products" class="btn btn-secondary btn-sm">Store Page</a>
          </div>
        </div>
{% endraw %}
{% endif %}{% endfor %}
{% if not guides.length %}<p class="text-muted">No manuals published yet.</p>{% endif %}
</div>
{% raw %}
    </div>
  </section>

  <!-- Beginner Onboarding FAQ Section -->
  <section class="section section-surface-dark">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">First Time Here?</span>
        <h2 class="section-title">Quick Onboarding &amp; FAQ</h2>
        <p class="section-subtitle">Everything you need to know about setting up your avatar at Control &amp; Chaos.</p>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3 class="card-title font-md mb-8">1. How do I join and start earning XP?</h3>
          <p class="card-desc m-0">
            Teleport to the Main Arrival Terminal at Control &amp; Chaos. Touch the terminal to register your avatar in the Experience cloud. Choose either the Dominant (DOM) or Submissive (SUB) path.
          </p>
        </div>

        <div class="card">
          <h3 class="card-title font-md mb-8">2. How do Profile Pick bonuses work?</h3>
          <p class="card-desc m-0">
            Keep 'Control &amp; Chaos' in your SL Profile Picks. Every 7 days you maintain the pick, you earn an escalating XP bonus and Gold Coin reward when touching the Weekly Terminal.
          </p>
        </div>

        <div class="card">
          <h3 class="card-title font-md mb-8">3. What happens in the Cage Break arena?</h3>
          <p class="card-desc m-0">
            Submissives can be jailed in the cage by registered Dominants. Fellow submissives can hack the laser lock to free prisoners, awarding massive bonus XP to both players!
          </p>
        </div>

        <div class="card">
          <h3 class="card-title font-md mb-8">4. Where can I get in-world assistance?</h3>
          <p class="card-desc m-0">
            Our Concierge and Mentors are available 24/7 at the Control &amp; Chaos VIP Lounge. You can also join our in-world group for live announcements and tournament alerts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
