{% extends "layouts/site.njk" %}
{% block content %}
<header class="hero tw:[min-height:50vh] tw:[padding:120px_0_40px] tw:[background:linear-gradient(180deg,_#221a15_0%,_#12100e_100%)]">
  <canvas height="" width="" id="hero-canvas"></canvas>
  <div class="container">
    <div class="hero-pill"><span class="pill-dot"></span><span>{{ guide.pill_text }}</span></div>
    <h1 class="hero-title tw:[font-size:42px]">{{ guide.title }} <span class="gold-gradient-text">USER MANUAL</span></h1>
    <p class="hero-description">{{ guide.description }}</p>
    <div class="tw:[display:flex] tw:[gap:14px] tw:[margin-top:24px] tw:[flex-wrap:wrap]">
      <a href="{{ guide.marketplace_url }}" target="_blank" rel="noopener" class="btn btn-gold"><span>&#128722;</span> Buy on SL Marketplace ({{ guide.price }}) &#8594;</a>
      <a href="#{{ guide.sections[0].section_id }}" class="btn btn-secondary"><span>&#9889;</span> Quick Start Guide</a>
    </div>
  </div>
</header>
<main class="section" data-cms-guide>
  <div class="container profile-main-layout tw:[display:grid] tw:[grid-template-columns:1.5fr_0.9fr] tw:[gap:40px]">
    <div>{% include "partials/guide-sections.njk" %}</div>
    <div>
      <div class="card tw:[border-color:var(--gold-bright)] tw:[background:linear-gradient(165deg,_#2a221b_0%,_#171411_100%)] tw:[margin-bottom:28px]">
        <div class="guide-product-media"><img src="{{ guide.listing.image }}" alt="{{ guide.title }}"></div>
        <span class="section-tag tw:[background:var(--gold-bright)] tw:[color:var(--bg-dark)] tw:[margin-bottom:8px] tw:[align-self:flex-start]">{{ guide.badge }}</span>
        <h3 class="card-title tw:[font-size:20px]">{{ guide.title }}</h3>
        <div class="tw:[font-family:var(--font-heading)] tw:[font-size:28px] tw:[color:var(--gold-bright)] tw:[margin:8px_0_14px]">{{ guide.price }}</div>
        <p class="tw:[font-size:13.5px] tw:[color:var(--text-muted)] tw:[line-height:1.55] tw:[margin-bottom:18px]">{{ guide.description }}</p>
        <a href="{{ guide.marketplace_url }}" target="_blank" rel="noopener" class="btn btn-gold tw:[width:100%]"><span>&#128722;</span> Buy on SL Marketplace ({{ guide.price }}) &#8594;</a>
      </div>
      <div class="card tw:[margin-bottom:28px]" id="guide-specs">
        <h3 class="card-title tw:[font-size:18px] tw:[margin-bottom:14px]">&#9881; Technical Specifications</h3>
        <dl class="manual-specs">
{% for name, value in guide.specs %}{% if value %}<div><dt>{{ name | capitalize }}</dt><dd>{{ value }}</dd></div>{% endif %}{% endfor %}
        </dl>
      </div>
      <div class="card">
        <h3 class="card-title tw:[font-size:18px] tw:[margin-bottom:14px]">&#128216; Explore Other Manuals</h3>
        <div class="tw:[display:flex] tw:[flex-direction:column] tw:[gap:10px]">{% for other in otherGuides %}<a href="{{ other.url }}" class="btn btn-secondary btn-sm tw:[justify-content:flex-start]"><span>{{ other.icon }}</span> {{ other.title }}</a>{% endfor %}</div>
      </div>
    </div>
  </div>
</main>
{% endblock %}