{% extends "layouts/site.njk" %}
{% block content %}
<main class="section account-section">
  <div class="container account-container">
    <header class="account-heading">
      <h1 class="section-title">Creator account</h1>
    </header>
    <p class="account-status" data-account-status role="status" aria-live="polite">Checking account...</p>
    <section class="preview-hidden" data-account-session>
      <h2 class="account-subheading">Signed in</h2>
      <p class="text-gold" data-account-email></p>
      <section class="account-verification">
        <h2 class="account-subheading">Web login</h2>
        <p>Your account email above is your web login. Set a password to sign in without the Second Life terminal. Login credentials are private and are not part of your public profile.</p>
        <button type="button" class="btn btn-secondary" data-account-change-password>Set or change web password</button>
      </section>
      <section class="account-verification" data-account-directory>
        <h2 class="account-subheading">Directory subscription</h2>
        <p class="account-status" data-subscription-status role="status" aria-live="polite"></p>
        <div class="account-actions" data-subscription-list></div>
        <button type="button" class="btn btn-secondary" data-subscription-refresh>Refresh subscriptions</button>
      </section>
      <section class="account-verification" data-account-creator-subscriptions>
        <h2 class="account-subheading">Creator subscriptions</h2>
        <p class="account-status" data-creator-subscription-status role="status" aria-live="polite"></p>
        <div class="account-actions" data-creator-subscription-list></div>
      </section>
      <section class="account-verification" data-avatar-verification>
        <h2 class="account-subheading">Second Life avatar</h2>
        <p class="account-status" data-avatar-status role="status" aria-live="polite"></p>
        <code class="account-verification-code preview-hidden" data-avatar-code></code>
        <div class="account-actions"><button type="button" class="btn btn-secondary" data-avatar-request>Get verification code</button><button type="button" class="btn btn-secondary" data-avatar-refresh>Refresh verification</button></div>
      </section>
      <div class="account-actions"><a href="/directory.html" class="btn btn-secondary">Directory</a><button type="button" class="btn btn-secondary" data-account-signout>Sign out</button></div>
    </section>
    <div class="preview-hidden" data-account-form-container>
      <div class="account-tabs" role="tablist" aria-label="Account action" data-account-tabs>
        <button type="button" class="btn btn-gold" role="tab" id="account-tab-signin" aria-controls="account-panel" aria-selected="true" data-account-mode="signin">Sign in</button>
        <button type="button" class="btn btn-secondary" role="tab" id="account-tab-signup" aria-controls="account-panel" aria-selected="false" tabindex="-1" data-account-mode="signup">Create account</button>
        <button type="button" class="btn btn-secondary" role="tab" id="account-tab-reset" aria-controls="account-panel" aria-selected="false" tabindex="-1" data-account-mode="reset">Reset password</button>
      </div>
      <section id="account-panel" role="tabpanel" aria-labelledby="account-tab-signin">
        <h2 class="account-subheading preview-hidden" data-account-recovery-title>Choose a new password</h2>
        <form class="account-form" data-live-auth-form>
          <div data-account-email-field><label for="account-email">Email address</label><input id="account-email" name="email" type="email" autocomplete="email" maxlength="254" required></div>
          <div data-account-password-field><label for="account-password">Password</label><input id="account-password" name="password" type="password" autocomplete="current-password" required></div>
          <div class="preview-hidden" data-account-confirm-field><label for="account-confirm">Confirm password</label><input id="account-confirm" name="confirmation" type="password" autocomplete="new-password"></div>
          <button type="submit" class="btn btn-gold account-submit" data-account-submit>Sign in</button>
          <button type="button" class="btn btn-secondary preview-hidden" data-account-cancel-password>Cancel password change</button>
        </form>
      </section>
    </div>
    <noscript><p>JavaScript is required to sign in.</p></noscript>
  </div>
</main>
{% endblock %}