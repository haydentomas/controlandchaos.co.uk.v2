{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Directory Hero -->
  <header class="hero hero-compact">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>CREATOR PROFILES • PUBLIC DIRECTORY</span>
      </div>
      <h1 class="hero-title hero-title-subpage">
        FINDOM &amp; COMPANION <span class="gold-gradient-text">DIRECTORY</span>
      </h1>
      <p class="hero-description">
        Connect with elite Financial Dominants, high-society Second Life escorts, and devoted submissives. Explore transparent service menus, RLV capabilities, and verified sim reputation.
      </p>
      <div class="tw:[margin-top:24px] tw:[display:flex] tw:[justify-content:center] tw:[gap:14px] tw:[flex-wrap:wrap]">
        <a href="/get-listed" class="btn btn-gold btn-sm tw:[display:inline-flex] tw:[align-items:center] tw:[gap:8px] tw:[font-weight:700] tw:[padding:8px_18px]">
          <span>👑</span> For Creators: Get Listed &amp; Rates Card →
        </a>
        <a href="/auth" class="btn btn-secondary btn-sm">Creator sign in</a>
      </div>
    </div>
  </header>

  <!-- Directory Content Section -->
  <section class="section">
    <div class="container">
      
      <!-- Search and Filter Controls -->
      <div class="dir-search-box">
        <input maxlength="120" aria-label="Search directory" data-directory-search="" type="text" placeholder="Search by name, username or specialty..." class="dir-search-input">

        <div class="dir-filters-bar">
          <div class="dir-filter-btns">
            <button class="btn btn-gold btn-sm" data-role="all">All Listings</button>
            <button class="btn btn-secondary btn-sm" data-role="domme">Dominants / Dommes</button>
            <button class="btn btn-secondary btn-sm" data-role="sub">Submissives / FinSubs</button>
            <button class="btn btn-secondary btn-sm" data-role="switch">Switches</button>
            <button class="btn btn-secondary btn-sm" data-tag="FinDom">FinDom</button>
            <button class="btn btn-secondary btn-sm" data-tag="RLV">RLV Restraints</button>
            <button class="btn btn-secondary btn-sm" data-tag="VIP">VIP Escort</button>
          </div>

          <div class="font-mono font-xs text-gold" data-directory-count aria-live="polite"></div>
        </div>
      </div>

      <!-- Profiles Grid -->
      {% endraw %}
{% include "partials/directory-card.njk" %}
{% raw %}
<div class="grid-3 profiles-container" data-directory-grid aria-busy="true"></div>
<p class="text-muted" data-directory-status role="status" aria-live="polite">Loading directory...</p>
<button class="btn btn-secondary btn-sm preview-hidden" data-directory-retry>Retry</button>
<div class="directory-pagination"><button class="btn btn-secondary btn-sm" data-directory-previous disabled>&#8592; Previous</button><button class="btn btn-secondary btn-sm" data-directory-next disabled>Next &#8594;</button></div>

    </div>
  </section>

  <!-- Sleek Creator Enrollment Callout Banner -->
  <section class="section tw:[padding-top:20px] tw:[padding-bottom:70px]">
    <div class="container">
      <div class="directory-div-presentation">
        <div class="tw:[max-width:620px]">
          <div class="tw:[display:flex] tw:[align-items:center] tw:[gap:8px] tw:[margin-bottom:8px]">
            <span class="section-tag tag-gold font-2xs tw:[margin:0]">FOR DOMINANTS &amp; COMPANIONS</span>
            <span class="tw:[font-size:0.8rem] tw:[color:#34d399] tw:[font-weight:700]">💎 100% In-World Revenue</span>
          </div>
          <h3 class="tw:[font-family:var(--font-heading)] tw:[font-size:1.6rem] tw:[color:#fff] tw:[margin:0_0_8px]">Want your rate card &amp; profile featured here?</h3>
          <p class="tw:[font-size:0.9rem] tw:[color:#94a3b8] tw:[margin:0] tw:[line-height:1.6]">
            Promote your services to the Control &amp; Chaos community with dedicated vanity URLs, custom domains, in-world billboard integration, and instant Linden (L$) activation.
          </p>
        </div>
        <div class="tw:[display:flex] tw:[gap:12px] tw:[flex-wrap:wrap]">
          <a href="/get-listed" class="btn btn-gold btn-md tw:[font-weight:800] tw:[padding:12px_24px] tw:[box-shadow:0_0_20px_rgba(212,175,55,0.25)]">
            <span>👑</span> View Packages &amp; Get Listed →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
