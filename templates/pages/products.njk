{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Products Hero -->
  <header class="hero hero-compact">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>OFFICIAL RETAIL STORE • HARDWARE &amp; WEARABLES</span>
      </div>
      <h1 class="hero-title hero-title-subpage">
        THE CONTROL &amp; CHAOS <span class="gold-gradient-text">STORE</span>
      </h1>
      <p class="hero-description">
        Explore our complete lineup of Second Life hardware and smart scripted wearables. Every product features full user guide documentation and instant delivery on the Second Life Marketplace.
      </p>
    </div>
  </header>

  <!-- Product Grid -->
  <section class="section">
    <div class="container">
      <div class="grid-3">

        <!-- Product 1: Vow Collar 2026 -->
        <div class="card card-highlight-gold card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/vow-collar.jpg" alt="[C&C] Vow Collar 2026 Package">
          </div>
          <span class="section-tag tag-burgundy mb-10 align-start">FLAGSHIP HARDWARE</span>
          <h3 class="card-title">[C&amp;C] Vow Collar 2026</h3>
          <div class="card-price-badge font-lg mb-8">L$2,499</div>
          <p class="card-desc card-body-grow">
            Complete retail package featuring Bento collar, multi-sub Domme HUD, direct in-collar debit with Air Taxes, multi-sim GPS radar, Experience auto-props (Ballgag, Snout), and LinksetData storage.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-vow-collar" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

        <!-- Product 2: PocketPig Companion -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/pocket-pig.jpg" alt="[C&C] PocketPig Companion HUD">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">COMPANION HUD</span>
          <h3 class="card-title">[C&amp;C] PocketPig Companion</h3>
          <div class="card-price-badge font-lg mb-8">L$899</div>
          <p class="card-desc card-body-grow">
            Interactive FinSub HUD tracking wallet hunger. Enforces live tribute reminders, triggers pig squeals and snout props when neglected, and links with Mistress's Tribute Jar.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-pocket-pig" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

        <!-- Product 3: FootKiss Worship -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/footkiss.png" alt="[C&C] FootKiss & Shoe Worship Suite">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">WORSHIP SYSTEM</span>
          <h3 class="card-title">[C&amp;C] FootKiss &amp; Shoe Worship</h3>
          <div class="card-price-badge font-lg mb-8">L$1,199</div>
          <p class="card-desc card-body-grow">
            Drop-in footwear script suite with proximity kneeling, kiss animations, configurable tribute-per-kiss charges, Bento shoe-shine props, and pedestal worship integration.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-footkiss" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

        <!-- Product 4: Smart Tribute Jar -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/tribute-jar.png" alt="[C&C] Smart Tribute Jar">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">VENUE ESSENTIAL</span>
          <h3 class="card-title">[C&amp;C] Smart Tribute Jar</h3>
          <div class="card-price-badge font-lg mb-8">L$750</div>
          <p class="card-desc card-body-grow">
            Gamified smart tip jar rewarding submissives with +XP and Gold Coins on tribute, custom tip buttons, particle celebrations, Discord webhook alerts, and split revenue.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-tribute-jars" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

        <!-- Product 5: Free XP Titler -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/xp-titler.png" alt="[C&C] Free XP Titler">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">FREE STARTER</span>
          <h3 class="card-title">[C&amp;C] Free XP Titler</h3>
          <div class="card-price-badge font-lg mb-8">L$0 (FREE)</div>
          <p class="card-desc card-body-grow">
            Floating overhead titler synchronizing with your Experience Cloud level, active rank title (e.g. Initiate, Sovereign, Icon), Prestige star status, and weekly streak bonuses.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-xp-titlers" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

        <!-- Product 6: Vow ATM Terminal -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/vow-atm.jpg" alt="[C&C] Vow ATM Terminal">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">VENUE HARDWARE</span>
          <h3 class="card-title">[C&amp;C] Vow ATM Terminal</h3>
          <div class="card-price-badge font-lg mb-8">In Vow Retail Pack</div>
          <p class="card-desc card-body-grow">
            Rezzable venue terminal allowing guests to tribute registered house Dominants directly, earn loyalty points, and print tribute milestone certificates.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-vow-collar" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="/products" class="btn btn-gold btn-sm card-body-grow">⛓️ Store Page</a>
          </div>
        </div>

        <!-- Product 7: Arcade & Mini-Game Bridges -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/shop-banner.png" alt="Arcade & Mini-Game Bridges">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">VENUE BRIDGE</span>
          <h3 class="card-title">Arcade &amp; Mini-Game Bridges</h3>
          <div class="card-price-badge font-lg mb-8">Sim Partner Kit</div>
          <p class="card-desc card-body-grow">
            Plug-and-play adapter scripts for popular Second Life games (Greedy, Canasta, Merge Game) that reward venue patrons with Control &amp; Chaos XP as they play.
          </p>
          <div class="card-actions-bar">
            <a href="/guides" class="btn btn-secondary btn-sm card-body-grow">📘 Partner Docs</a>
            <a href="/contact" class="btn btn-gold btn-sm card-body-grow">✨ Partner Inquiry</a>
          </div>
        </div>

        <!-- Product 8: ButtKiss Worship Suite -->
        <div class="card card-flex-column">
          <div class="card-product-media">
            <img src="/images/products/buttkiss.jpg" alt="[C&C] ButtKiss & Worship Suite">
          </div>
          <span class="section-tag manifesto-tag mb-10 align-start">WORSHIP SYSTEM</span>
          <h3 class="card-title">[C&amp;C] ButtKiss Worship Suite</h3>
          <div class="card-price-badge font-lg mb-8">L$1,199</div>
          <p class="card-desc card-body-grow">
            Interactive wearable worship system bringing submissives down to their knees for direct tributes, butt kiss animations, picture sales, and devotion milestone rewards.
          </p>
          <div class="card-actions-bar">
            <a href="/guide-footkiss" class="btn btn-secondary btn-sm card-body-grow">📘 User Guide</a>
            <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">🛒 Marketplace</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
