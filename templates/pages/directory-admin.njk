{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<main class="section directory-admin-page" data-directory-admin>
  <div class="container directory-admin-container">
    <header class="directory-admin-header">
      <div><span class="directory-admin-eyebrow">Control &amp; Chaos</span><h1 class="section-title">Directory administration</h1></div>
      <a class="btn btn-secondary" href="/directory">View directory</a>
    </header>
    <p class="directory-admin-status" data-admin-status role="status" aria-live="polite">Checking administrator access...</p>
    <section class="directory-admin-gate" data-admin-gate>
      <h2>Superadmin sign-in required</h2>
      <p>Sign in with the designated ControlandChaos account. Access is verified by the database; no admin token is stored in this page.</p>
      <a class="btn btn-gold" href="/auth" data-admin-signin>Sign in</a>
    </section>
    <section class="directory-admin-console preview-hidden" data-admin-console>
      <div class="directory-admin-toolbar"><p class="directory-admin-privacy-note">Payment records and credentials are not available in this console.</p><button type="button" class="btn btn-secondary" data-admin-signout>Sign out</button></div>
      <nav class="directory-admin-tabs" aria-label="Administration sections">
        <button type="button" class="btn btn-gold" data-admin-tab="listings" aria-selected="true">Listings</button>
        <button type="button" class="btn btn-secondary" data-admin-tab="subscribers" aria-selected="false">Subscribers</button>
      </nav>
      <section class="directory-admin-pane" data-admin-listings-pane>
        <div class="directory-admin-toolbar">
          <label class="directory-admin-search"><span>Find a listing</span><input type="search" maxlength="120" placeholder="Name, username, slug, or ID" data-admin-listing-search></label>
          <button type="button" class="btn btn-secondary" data-admin-listing-refresh>Refresh listings</button>
        </div>
        <div class="directory-admin-list" data-admin-listings></div>
      </section>
      <section class="directory-admin-pane preview-hidden" data-admin-subscribers-pane>
        <div class="directory-admin-toolbar">
          <label class="directory-admin-search"><span>Find a subscriber</span><input type="search" maxlength="120" placeholder="Avatar, username, or creator" data-admin-subscriber-search></label>
          <label class="directory-admin-filter"><span>Subscription type</span><select data-admin-subscriber-type><option value="all">All</option><option value="directory">Directory</option><option value="creator">Creator</option></select></label>
          <button type="button" class="btn btn-secondary" data-admin-subscriber-refresh>Refresh subscribers</button>
        </div>
        <div class="directory-admin-list" data-admin-subscribers></div>
      </section>
    </section>
  </div>
  <dialog class="directory-admin-dialog" data-admin-edit-dialog>
    <form method="dialog" class="directory-admin-edit-form" data-admin-edit-form>
      <header><div><span class="directory-admin-eyebrow">Listing editor</span><h2 data-admin-edit-title>Edit listing</h2></div><button type="button" class="btn btn-secondary" data-admin-edit-cancel>Close</button></header>
      <div class="directory-admin-edit-grid">
        <label>Display name<input name="display_name" maxlength="100" required></label>
        <label>Role<select name="role_type"><option value="domme">Domme</option><option value="sub">Submissive</option><option value="switch">Switch</option></select></label>
        <label>Headline<input name="headline" maxlength="160"></label>
        <label>Tags (comma-separated)<input name="tags" maxlength="1000"></label>
        <label>Starting rate<input name="starting_rate" maxlength="100"></label>
        <label>Availability<select name="availability"><option value="available">Available</option><option value="busy">Busy</option><option value="away">Away</option><option value="offline">Offline</option></select></label>
        <label>Avatar image URL<input name="avatar_image" maxlength="2048"></label>
        <label>Banner image URL<input name="banner_image" maxlength="2048"></label>
        <label>Creator monthly price (L$)<input name="creator_blog_monthly_linden" type="number" min="0" max="1000000" step="1"></label>
        <label class="admin-edit-wide">Tagline<textarea name="tagline" maxlength="1000" rows="3"></textarea></label>
        <label class="admin-edit-wide">About<textarea name="about" maxlength="20000" rows="6"></textarea></label>
        <label class="admin-edit-wide">Availability note<textarea name="availability_note" maxlength="500" rows="2"></textarea></label>
        <label class="admin-edit-wide">Boundaries<textarea name="boundaries" maxlength="4000" rows="4"></textarea></label>
        <label class="admin-edit-wide">How to book<textarea name="booking_instructions" maxlength="4000" rows="4"></textarea></label>
        <label class="admin-edit-wide">Creator pass benefits<textarea name="creator_blog_benefits" maxlength="1000" rows="3"></textarea></label>
        <label>Toys section title<input name="hardware_title" maxlength="100"></label>
        <label>Wishlist section title<input name="wishlist_title" maxlength="100"></label>
        <label class="admin-edit-wide">Rate categories JSON<textarea name="rate_categories" rows="8" spellcheck="false"></textarea></label>
        <label class="admin-edit-wide">Booking hours JSON<textarea name="booking_hours" rows="6" spellcheck="false"></textarea></label>
        <label class="admin-edit-wide">Toys JSON<textarea name="hardware_compat" rows="6" spellcheck="false"></textarea></label>
        <label class="admin-edit-wide">Wishlist JSON<textarea name="wishlist" rows="6" spellcheck="false"></textarea></label>
        <label class="admin-feature-toggle"><input name="is_featured" type="checkbox"> Feature this listing</label>
      </div>
      <footer><button type="button" class="btn btn-secondary" data-admin-edit-cancel>Cancel</button><button type="submit" class="btn btn-gold">Save listing</button></footer>
    </form>
  </dialog>
</main>
{% endraw %}
{% endblock %}
