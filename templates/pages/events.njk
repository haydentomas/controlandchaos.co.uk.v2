{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Events Hero -->
  <header class="hero hero-compact">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>TOURNAMENTS • LUXURY GALAS • DOUBLE XP</span>
      </div>
      <h1 class="hero-title hero-title-subpage">
        SIM EVENTS &amp; <span class="gold-gradient-text">CALENDAR</span>
      </h1>
      <p class="hero-description">
        Stay updated on weekly Cage Break arena tournaments, high-society FinDom galas, workshop masterclasses, and Double XP weekends. Add events directly to your personal Google Calendar.
      </p>
    </div>
  </header>

  <!-- Events List Section -->
  <section class="section">
    <div class="container">
      
      <!-- Filter Tabs -->
      <div class="flex-between align-center gap-16 mb-36 flex-wrap">
        <div class="flex-row gap-8 flex-wrap">
          <button class="btn btn-gold btn-sm" data-filter="all">All Events</button>
          <button class="btn btn-secondary btn-sm" data-filter="Tournament">Tournaments</button>
          <button class="btn btn-secondary btn-sm" data-filter="Gala">Galas &amp; Balls</button>
          <button class="btn btn-secondary btn-sm" data-filter="Community">Double XP &amp; Tributes</button>
          <button class="btn btn-secondary btn-sm" data-filter="Workshop">Workshops</button>
        </div>
        <div class="font-mono font-xs text-muted">Showing 4 of 4 events</div>
      </div>

      <!-- Events Grid -->
      <div class="grid-2"><div class="card card-flex-column">
            <div class="flex-between align-start mb-12 gap-8">
              <span class="section-tag font-2xs m-0">TOURNAMENT</span>
              <span class="font-mono font-xs text-gold">Every Saturday • 1:00 PM SLT (PDT)</span>
            </div>

            <h3 class="card-title font-md mb-10">⚡ Cage Break Championship &amp; Double XP Rush</h3>

            <div class="font-xs text-muted mb-12 flex-row align-center gap-6">
              <span>📍</span> <span>Control &amp; Chaos Arena &amp; Central Laser Cages</span>
            </div>

            <p class="card-desc card-body-grow mb-20">
              The premier sim combat and jailbreak tournament! Dominants defend the cages while submissives attempt daring laser lock hacks. Double XP, +500 Gold Coins, and champion title trophies awarded to top scorers.
            </p>

            <div class="card-actions-bar">
              <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Control%20%26%20Chaos%3A%20Cage%20Break%20Tournament%20(Double%20XP)&details=The%20premier%20sim%20combat%20and%20jailbreak%20tournament!%20Dominants%20defend%20the%20cages%20while%20submissives%20attempt%20daring%20laser%20lock%20hacks.%20Double%20XP%2C%20%2B500%20Gold%20Coins%2C%20and%20champion%20title%20trophies%20awarded%20to%20top%20scorers.&location=Control%20%26%20Chaos%20Arena%20%26%20Central%20Laser%20Cages" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">
                <span>📅</span> Add to Google Calendar
              </a>
              <a href="secondlife://Chaos%20Manor/128/128/23" class="btn btn-secondary btn-sm">
                <span>📍</span> Teleport (SLurl)
              </a>
            </div>
          </div><div class="card card-flex-column">
            <div class="flex-between align-start mb-12 gap-8">
              <span class="section-tag font-2xs m-0">LUXURY GALA</span>
              <span class="font-mono font-xs text-gold">Friday, Oct 9 • 6:00 PM SLT (PDT)</span>
            </div>

            <h3 class="card-title font-md mb-10">👑 High Society FinDom Gala &amp; Escort Showcase</h3>

            <div class="font-xs text-muted mb-12 flex-row align-center gap-6">
              <span>📍</span> <span>Control &amp; Chaos Grand Ballroom &amp; VIP Lounge</span>
            </div>

            <p class="card-desc card-body-grow mb-20">
              Formal black-tie ball showcasing our verified Service Providers and house Dominants. Live classical-electronic DJ set, champagne tribute fountains, and VIP escort auction.
            </p>

            <div class="card-actions-bar">
              <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Control%20%26%20Chaos%3A%20High%20Society%20FinDom%20Gala&details=Formal%20black-tie%20ball%20showcasing%20our%20verified%20Service%20Providers%20and%20house%20Dominants.%20Live%20classical-electronic%20DJ%20set%2C%20champagne%20tribute%20fountains%2C%20and%20VIP%20escort%20auction.&location=Control%20%26%20Chaos%20Grand%20Ballroom%20%26%20VIP%20Lounge" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">
                <span>📅</span> Add to Google Calendar
              </a>
              <a href="secondlife://Chaos%20Manor/160/140/35" class="btn btn-secondary btn-sm">
                <span>📍</span> Teleport (SLurl)
              </a>
            </div>
          </div><div class="card card-flex-column">
            <div class="flex-between align-start mb-12 gap-8">
              <span class="section-tag font-2xs m-0">COMMUNITY EVENT</span>
              <span class="font-mono font-xs text-gold">Every Sunday • 2:00 PM – 4:00 PM SLT</span>
            </div>

            <h3 class="card-title font-md mb-10">🪙 Sunday Gold Rush &amp; Tribute Jar Bonanza</h3>

            <div class="font-xs text-muted mb-12 flex-row align-center gap-6">
              <span>📍</span> <span>Main Arcade &amp; Tribute Hub</span>
            </div>

            <p class="card-desc card-body-grow mb-20">
              All Tribute Jars across the sim award 1.5x Gold Coins and double XP multipliers. Community tipping contests, live leaderboard tracking, and mini-game bonuses.
            </p>

            <div class="card-actions-bar">
              <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Control%20%26%20Chaos%3A%20Sunday%20Gold%20Rush%20(1.5x%20Bonus)&details=All%20Tribute%20Jars%20across%20the%20sim%20award%201.5x%20Gold%20Coins%20and%20double%20XP%20multipliers.%20Community%20tipping%20contests%2C%20live%20leaderboard%20tracking%2C%20and%20mini-game%20bonuses.&location=Main%20Arcade%20%26%20Tribute%20Hub" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">
                <span>📅</span> Add to Google Calendar
              </a>
              <a href="secondlife://Chaos%20Manor/128/50/23" class="btn btn-secondary btn-sm">
                <span>📍</span> Teleport (SLurl)
              </a>
            </div>
          </div><div class="card card-flex-column">
            <div class="flex-between align-start mb-12 gap-8">
              <span class="section-tag font-2xs m-0">MASTERCLASS</span>
              <span class="font-mono font-xs text-gold">Wednesday, Oct 14 • 4:00 PM SLT</span>
            </div>

            <h3 class="card-title font-md mb-10">📜 Dominance, RLV &amp; FinDom Protocol Workshop</h3>

            <div class="font-xs text-muted mb-12 flex-row align-center gap-6">
              <span>📍</span> <span>The Velvet Chamber &amp; Lecture Hall</span>
            </div>

            <p class="card-desc card-body-grow mb-20">
              Interactive masterclass led by Lady Seraphina Noir and Mistress Alexis Vane. Covering Vow Collar direct debit policies, consensual psychological boundaries, and Firestorm RLV tuning.
            </p>

            <div class="card-actions-bar">
              <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Control%20%26%20Chaos%3A%20Dominance%20%26%20RLV%20Protocol%20Workshop&details=Interactive%20masterclass%20led%20by%20Lady%20Seraphina%20Noir%20and%20Mistress%20Alexis%20Vane.%20Covering%20Vow%20Collar%20direct%20debit%20policies%2C%20consensual%20psychological%20boundaries%2C%20and%20Firestorm%20RLV%20tuning.&location=The%20Velvet%20Chamber%20%26%20Lecture%20Hall" target="_blank" rel="noopener" class="btn btn-gold btn-sm card-body-grow">
                <span>📅</span> Add to Google Calendar
              </a>
              <a href="secondlife://Chaos%20Manor/64/180/23" class="btn btn-secondary btn-sm">
                <span>📍</span> Teleport (SLurl)
              </a>
            </div>
          </div></div>

    </div>
  </section>

  <!-- Google Calendar Embed & Subscription Card -->
  <section class="section section-surface-dark">
    <div class="container">
      <div class="card card-highlight-gold p-36">
        <div class="flex-between align-center gap-24 flex-wrap">
          <div class="callout-banner-content">
            <span class="section-tag tag-gold mb-8">CALENDAR INTEGRATION</span>
            <h2 class="card-title font-lg m-0 mb-10">Subscribe to Control &amp; Chaos on Google Calendar</h2>
            <p class="card-desc m-0">
              Never miss a double XP tournament or sim gala! Add our official event schedule directly to your Google Calendar, Apple Calendar, or Outlook for live reminders in your local timezone.
            </p>
          </div>
          <div class="flex-row gap-12 flex-wrap">
            <a href="https://calendar.google.com/calendar/render?cid=controlandchaos" target="_blank" rel="noopener" class="btn btn-gold">
              <span>📅</span> Add to Google Calendar →
            </a>
            <a href="http://maps.secondlife.com/secondlife/Los%20Pengos/97/181/3000" target="_blank" rel="noopener" class="btn btn-secondary">
              <span>📍</span> Teleport to Sim
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
