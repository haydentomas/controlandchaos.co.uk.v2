{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Contact Hero -->
  <header class="hero hero-compact">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">

      <h1 class="hero-title hero-title-subpage">
        GET IN <span class="gold-gradient-text">TOUCH</span>
      </h1>
      <p class="hero-description">
        Send us a message! Whether you need help getting started with Control &amp; Chaos XP system, need product
        support or just want to say hi! We are friendly, supportive and always happy to help!
    </p></div>
  </header>

  <!-- Main Contact Content -->
  <main class="section">
    <div class="container">
      <div class="contact-layout-grid">

        <!-- Left Column: Direct People & In-World Channels -->
        <div>
          <!-- Contact Card: Lexi Zane -->
          <div class="direct-card">
            <div class="flex-between align-start mb-10 gap-8">
              <div>
                <span class="section-tag font-2xs m-0 mb-6">DOMINANT • MANAGEMENT</span>
                <h3 class="card-title font-md m-0">Lexi Zane</h3>
              </div>
              <div class="font-xl">👑</div>
            </div>
            <p class="card-desc mb-14">
              Control &amp; Chaos Queen. I am the main point of contact for any questions or concerns you may have

            </p>
            <div class="flex-between align-center flex-wrap gap-10 card-actions-bar">
              <span class="copy-chip" title="Click to copy SL username">
                <span>📋</span> lexi.zane
              </span>
              <a href="https://my.secondlife.com/lexi.leborski" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" title="View official web profile on Second Life">
                <span>🌐</span> View Profile
              </a>
            </div>
          </div>

          <!-- Contact Card: Alek Zane -->
          <div class="direct-card">
            <div class="flex-between align-start mb-10 gap-8">
              <div>
                <span class="section-tag font-2xs m-0 mb-6">Alpha Sub. Owner. Tech</span>
                <h3 class="card-title font-md m-0">Alek Zane</h3>
              </div>
              <div class="font-xl">⚙️</div>
            </div>
            <p class="card-desc mb-14">
              Creator of Control &amp; Chaos. Send me a message if you have any questions, concerns, or tech support,
              whether
              its sim or product related.

            </p>
            <div class="flex-between align-center flex-wrap gap-10 card-actions-bar">
              <span class="copy-chip" title="Click to copy SL username">
                <span>📋</span> alek.zane
              </span>
              <a href="https://my.secondlife.com/alek.zane" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" title="View official web profile on Second Life">
                <span>🌐</span> View Profile
              </a>
            </div>
          </div>



          <!-- In-World Sim Office & Teleport Card -->
          <div class="card p-22 card-flex-column">
            <div class="flex-row align-center gap-10 mb-10">
              <span class="font-md">📍</span>
              <h4 class="card-title font-sm text-gold m-0">In-World Estate Office</h4>
            </div>
            <p class="card-desc mb-14 font-sm">
              Visit the Executive Concierge Lounge at Control &amp; Chaos for in-world notecard dropboxes, live vendor
              redelivery kiosks, and direct sim support.
            </p>
            <a href="http://maps.secondlife.com/secondlife/Los%20Pengos/97/181/3000" target="_blank" rel="noopener" class="btn btn-gold btn-sm w-100 flex-center">
              <span>📍</span> Teleport to Estate Office (SLurl)
            </a>
          </div>

        </div>

        <!-- Right Column: Interactive Dispatch & Support Form -->
        <div>
          <div class="contact-form-card">

            <div class="mb-24">
              <span class="section-tag tag-gold mb-8">CONTACT FORM</span>
              <h2 class="card-title font-lg m-0 mb-6">
                Send a Direct Message
              </h2>
              <p class="card-desc m-0">
                Fill this in and we will get back to you as soon as possible.
              </p>
            </div>

            <!-- Form Body with Netlify Forms Integration -->
            <form name="contact" netlify="" netlify-honeypot="bot-field">
              
              <p class="tw:[display:none]"><input name="bot-field"></p>

              <div class="form-grid-2col">
                <div class="form-group">
                  <label class="form-label" for="contact-username">Second Life Username or Name *</label>
                  <input type="text" id="contact-username" name="sl_username" class="form-input" placeholder="e.g. resident.username or your name" required>
                </div>
                <div class="form-group">
                  <label class="form-label" for="contact-displayname">Display Name</label>
                  <input type="text" id="contact-displayname" name="display_name" class="form-input" placeholder="e.g. Lady V / Master Zane">
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-email">Email Address (Optional)</label>
                <input type="email" id="contact-email" name="email" class="form-input" placeholder="if you want an email response (optional)">
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-dept">Subject &amp; Department *</label>
                <select id="contact-dept" name="department" class="form-select" required>
                  <option value="General Inquiry">💬 General Sim Inquiry</option>
                  <option value="LSL Hardware / Vow Collar Support">⚙️ Product Support (Alek
                    Zane)</option>`
                  <option value="Sim Events & Gala Coordination">👑 Sim Events (Lexi Zane)</option>
                  <option value="Directory Application Verification">📋 Service Provider Directory Listing Inquiry
                  </option>

                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="contact-message">Your Message *</label>
                <textarea id="contact-message" name="message" class="form-textarea" placeholder="Provide details regarding your request, questions, or transaction/order number if applicable..." required></textarea>
              </div>

              <div class="form-actions-bar">
                <label class="form-checkbox-label">
                  <input type="checkbox" name="urgent" class="form-checkbox-input">
                  <span>Mark as high priority dispatch</span>
                </label>

                <button type="submit" class="btn btn-gold btn-lg">
                  <span>✉️</span> Send Message
                </button>
              </div>



              <!-- Live Submission Feedback Box -->
              <div class="form-feedback-box"></div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
