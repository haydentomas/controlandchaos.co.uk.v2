{% extends "layouts/site.njk" %}
{% block content %}
{% raw %}
<!-- Master Navigation Component -->
  

  <!-- Product Guide Hero -->
  <header class="hero tw:[min-height:50vh] tw:[padding:120px_0_40px] tw:[background:linear-gradient(180deg,_#1f1814_0%,_#12100e_100%)]">
    <canvas height="" width="" id="hero-canvas"></canvas>
    <div class="container">
      <div class="hero-pill">
        <span class="pill-dot"></span>
        <span>OVERHEAD TITLER • SECOND LIFE 2026</span>
      </div>
      <h1 class="hero-title tw:[font-size:42px]">[C&amp;C] Free XP Titlers <span class="gold-gradient-text">USER MANUAL</span></h1>
      <p class="hero-description">Floating overhead titler synchronizing with your Experience Cloud level, active rank title (e.g. Initiate, Sovereign, Icon), Prestige star status, and weekly streak bonuses.</p>
      <div class="tw:[display:flex] tw:[gap:14px] tw:[margin-top:24px] tw:[flex-wrap:wrap]">
        <a href="/xp-system.html" class="btn btn-gold">
          <span>⚡</span> View XP Leveling Curve →
        </a>
        <a href="#quick-start" class="btn btn-secondary">
          <span>⚡</span> Quick Start Guide
        </a>
      </div>
    </div>
  </header>

  <!-- Main Documentation Content -->
  <main class="section">
    <div class="container profile-main-layout tw:[display:grid] tw:[grid-template-columns:1.5fr_0.9fr] tw:[gap:40px]">
      
      <!-- Left Column -->
      <div><div class="card tw:[margin-bottom:28px]">
            <h2 class="card-title tw:[font-size:22px] tw:[margin-bottom:14px]">1. How to Claim &amp; Wear</h2>
            <div class="tw:[font-size:14.5px] tw:[color:var(--text-primary)] tw:[line-height:1.7]">
              <p class="tw:[margin-bottom:12px] tw:[line-height:1.7] tw:[color:var(--text-primary)]">Claim the <strong class="tw:[color:var(--gold-bright)]">[C&amp;C] Free XP Titler</strong> from the arrival landing point at Control &amp; Chaos or order free on SL Marketplace. Right-click &gt; Attach to <strong class="tw:[color:var(--gold-bright)]">Avatar Center 2</strong>.</p>
            </div>
          <div class="guide-xp-titlers-div-presentation">
              <strong class="tw:[color:var(--gold-bright)] tw:[font-size:14px] tw:[display:block] tw:[margin-bottom:8px]">Key Features:</strong>
              <ul class="tw:[padding-left:18px] tw:[font-size:13.5px] tw:[color:var(--text-muted)] tw:[line-height:1.65] tw:[margin:0]">
                <li><strong>Live Cloud Rank Sync:</strong> Automatically displays your real-time level and rank without manual notecard edits.</li><li><strong>Prestige Stars &amp; Streaks:</strong> Visual badge markers for VIP and top-tier sim leaderboard players.</li><li><strong>Color &amp; Style Picker:</strong> 12 velvet, obsidian, and champagne gold font styles.</li><li><strong>100% Free for Sim Visitors:</strong> Claimable from the arrival terminal at Control &amp; Chaos or on SL Marketplace.</li>
              </ul>
            </div></div><div class="card tw:[margin-bottom:28px]">
            <h2 class="card-title tw:[font-size:22px] tw:[margin-bottom:14px]">2. Customization Commands</h2>
            <div class="tw:[font-size:14.5px] tw:[color:var(--text-primary)] tw:[line-height:1.7]">
              <p class="tw:[margin-bottom:12px] tw:[line-height:1.7] tw:[color:var(--text-primary)]">Type <code class="tw:[font-family:var(--font-mono)] tw:[color:var(--gold-bright)] tw:[background:rgba(0,0,0,0.5)] tw:[padding:2px_6px] tw:[border-radius:4px] tw:[font-size:12px]">/11 titler menu</code> to change text colors, toggle prestige star icons, or switch to stealth mode.</p>
            </div>
          </div><div class="card tw:[margin-bottom:28px]">
            <h2 class="card-title tw:[font-size:22px] tw:[margin-bottom:14px]">💬 Chat &amp; Channel Commands</h2>
            <div class="tw:[overflow-x:auto]">
              <table class="table tw:[font-size:13px] tw:[width:100%]">
                <thead>
                  <tr>
                    <th>Command</th>
                    <th>Permission</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  
                    <tr>
                      <td><code class="tw:[font-family:var(--font-mono)] tw:[color:var(--gold-bright)]">/11 titler menu</code></td>
                      <td class="tw:[color:var(--gold-muted)]">Wearer</td>
                      <td>Opens customization dialog.</td>
                    </tr>
                  
                    <tr>
                      <td><code class="tw:[font-family:var(--font-mono)] tw:[color:var(--gold-bright)]">/11 titler hide</code></td>
                      <td class="tw:[color:var(--gold-muted)]">Wearer</td>
                      <td>Temporarily hides overhead floating text.</td>
                    </tr>
                  
                    <tr>
                      <td><code class="tw:[font-family:var(--font-mono)] tw:[color:var(--gold-bright)]">/11 titler show</code></td>
                      <td class="tw:[color:var(--gold-muted)]">Wearer</td>
                      <td>Restores floating title and stats.</td>
                    </tr>
                  
                </tbody>
              </table>
            </div>
          </div></div>

      <!-- Right Column -->
      <div>
        
        <!-- Free In-World Card -->
        <div class="card tw:[border-color:var(--gold-bright)] tw:[background:linear-gradient(165deg,_#2a221b_0%,_#171411_100%)] tw:[margin-bottom:28px]">
          <div class="guide-product-media">
            <img src="/images/products/xp-titler.png" alt="[C&C] Free XP Titler">
          </div>
          <span class="section-tag tw:[background:var(--gold-bright)] tw:[color:var(--bg-dark)] tw:[margin-bottom:8px] tw:[align-self:flex-start]">FREE STARTER</span>
          <h3 class="card-title tw:[font-size:20px]">[C&amp;C] Free XP Titlers Complete</h3>
          <div class="tw:[font-family:var(--font-heading)] tw:[font-size:28px] tw:[color:var(--gold-bright)] tw:[margin:8px_0_14px]">L$0 (FREE)</div>
          <p class="tw:[font-size:13.5px] tw:[color:var(--text-muted)] tw:[line-height:1.55] tw:[margin-bottom:18px]">
            Claimable 24/7 at the Control &amp; Chaos Main Arrival Hub or on the Second Life Marketplace.
          </p>
          <a href="https://marketplace.secondlife.com" target="_blank" rel="noopener" class="btn btn-gold tw:[width:100%]"><span>🛒</span> Buy on SL Marketplace (L$0 (FREE)) →</a>
        </div>

        <!-- Technical Specs -->
        <div class="card tw:[margin-bottom:28px]">
          <h3 class="card-title tw:[font-size:18px] tw:[margin-bottom:14px]">⚙️ Technical Specifications</h3>
          <ul class="tw:[list-style:none] tw:[padding:0] tw:[margin:0] tw:[display:flex] tw:[flex-direction:column] tw:[gap:10px] tw:[font-size:13px]">
          <li class="tw:[display:flex] tw:[justify-content:space-between] tw:[border-bottom:1px_solid_var(--gold-border-subtle)] tw:[padding-bottom:6px]">
            <span class="tw:[color:var(--text-muted)]">Attachment:</span>
            <span class="tw:[color:var(--gold-bright)]">Avatar Center 2 / Skull</span>
          </li>
          <li class="tw:[display:flex] tw:[justify-content:space-between] tw:[border-bottom:1px_solid_var(--gold-border-subtle)] tw:[padding-bottom:6px]">
            <span class="tw:[color:var(--text-muted)]">Permissions:</span>
            <span class="tw:[color:var(--gold-bright)] tw:[font-family:var(--font-mono)]">Copy / Mod / No-Transfer</span>
          </li>
          <li class="tw:[display:flex] tw:[justify-content:space-between] tw:[border-bottom:1px_solid_var(--gold-border-subtle)] tw:[padding-bottom:6px]">
            <span class="tw:[color:var(--text-muted)]">Compatibility:</span>
            <span class="tw:[color:var(--gold-bright)]">Control &amp; Chaos Experience Cloud</span>
          </li>
          <li class="tw:[display:flex] tw:[justify-content:space-between] tw:[padding-top:2px]">
            <span class="tw:[color:var(--text-muted)]">Contents:</span>
            <span class="tw:[color:var(--gold-bright)]">Titler Mesh, Setup Script, Style Palette</span>
          </li>
        </ul>
        </div>

        <!-- Other Guides -->
        <div class="card">
          <h3 class="card-title tw:[font-size:18px] tw:[margin-bottom:14px]">📘 Explore Other Manuals</h3>
          <div class="tw:[display:flex] tw:[flex-direction:column] tw:[gap:10px]">
            <a href="/guide-vow-collar.html" class="btn btn-secondary btn-sm tw:[justify-content:flex-start]">
              <span>⛓️</span> Vow Collar 2026 Manual
            </a>
            <a href="/guide-pocket-pig.html" class="btn btn-secondary btn-sm tw:[justify-content:flex-start]">
              <span>🐷</span> PocketPig Companion Manual
            </a>
            <a href="/guide-footkiss.html" class="btn btn-secondary btn-sm tw:[justify-content:flex-start]">
              <span>👠</span> FootKiss Worship Manual
            </a>
            <a href="/guide-tribute-jars.html" class="btn btn-secondary btn-sm tw:[justify-content:flex-start]">
              <span>🏺</span> Smart Tribute Jars Manual
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- Master Footer Component -->
{% endraw %}
{% endblock %}
