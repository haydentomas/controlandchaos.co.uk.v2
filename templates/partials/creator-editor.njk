<main class="section">
  <div class="editor-wide-container creator-editor">
    <header class="account-heading"><h1 class="section-title">Profile Studio</h1><a class="btn btn-secondary" href="/auth.html">My account</a></header>
    <p class="account-status" data-creator-status role="status" aria-live="polite">Checking profile access...</p>
    <div class="account-actions"><a class="btn btn-gold preview-hidden" data-creator-signin href="/auth.html">Sign in</a><button class="btn btn-secondary" type="button" data-creator-reload>Refresh access</button></div>
    <form class="preview-hidden" data-live-profile-form>
      <div class="creator-editor-toolbar"><label for="creator-profile">Profile</label><select id="creator-profile" class="form-select" data-creator-profile></select><p class="text-muted" data-creator-subscription></p><a class="btn btn-secondary preview-hidden" data-creator-public href="/directory.html" target="_blank" rel="noopener">View public profile</a></div>
      <fieldset disabled data-creator-fields>
        <div class="creator-editor-layout">
          <aside class="creator-editor-sidebar">
            <nav class="creator-editor-nav" aria-label="Profile sections">
              <a href="#creator-identity">Identity &amp; Availability</a>
              <a href="#creator-booking">Booking Hours</a>
              <a href="#creator-bio">Profile Text</a>
              <a href="#creator-protocol">Boundaries &amp; How to Book</a>
              <a href="#creator-images">Photos &amp; Visuals</a>
              <a href="#creator-gallery">Gallery</a>
              <a href="#creator-rates">Rate Cards</a>
              <a href="#creator-toys-wishlist">Toys &amp; Wishlist</a>
            </nav>
            <div class="creator-editor-toolbar creator-editor-savebar"><label class="profile-feature-switch"><input type="checkbox" name="is_published"><span>Publish profile</span></label><button class="btn btn-gold" type="submit" data-creator-save>Save profile</button><p class="text-muted" data-creator-publication></p></div>
          </aside>
          <div class="creator-editor-content">
        <section class="creator-editor-section" id="creator-identity" aria-labelledby="creator-identity-title">
          <h2 id="creator-identity-title" class="account-subheading">Identity &amp; Availability</h2>
          <div class="form-grid-2">
            <div><label class="form-label" for="creator-name">Display name</label><input class="form-input" id="creator-name" name="display_name" maxlength="100" required></div>
            <div class="creator-verified-username"><label class="form-label" for="creator-username">Verified Second Life username</label><input class="form-input" id="creator-username" data-creator-username aria-describedby="creator-username-note" readonly><p class="text-muted" id="creator-username-note">From your linked avatar</p></div>
            <div><label class="form-label" for="creator-role">Role</label><select class="form-select" id="creator-role" name="role_type"><option value="domme">Dominant / Domme</option><option value="sub">Submissive / Finsub</option><option value="switch">Switch</option></select></div>
            <div><label class="form-label" for="creator-availability">Availability</label><select class="form-select" id="creator-availability" name="availability"><option value="available">Available</option><option value="busy">Busy</option><option value="away">Away</option><option value="offline">Offline</option></select></div>
            <div><label class="form-label" for="creator-headline">Headline</label><input class="form-input" id="creator-headline" name="headline" maxlength="160"></div>
            <div><label class="form-label" for="creator-rate">Starting rate</label><input class="form-input" id="creator-rate" name="starting_rate" maxlength="100"></div>
          </div>
          <label class="form-label" for="creator-availability-note">Availability note</label><input class="form-input" id="creator-availability-note" name="availability_note" maxlength="500">
        </section>
        <section class="creator-editor-section" id="creator-booking" aria-labelledby="creator-booking-title" data-booking-editor>
          <h2 id="creator-booking-title" class="account-subheading">Booking Hours &amp; Availability</h2>
          <label class="profile-feature-switch"><input type="checkbox" data-booking-enabled><span>Show booking hours</span></label>
          <fieldset disabled data-booking-fields>
            <div class="form-grid-2">
              <div><label class="form-label" for="booking-timezone">Timezone reference</label><select id="booking-timezone" class="form-select" data-booking-timezone></select></div>
              <div><label class="form-label" for="booking-interval">Appointment interval</label><select id="booking-interval" class="form-select" data-booking-interval><option value="30">30 minutes</option><option value="60">1 hour</option><option value="120">2 hours</option></select></div>
              <div><label class="form-label" for="booking-start">Start time</label><input id="booking-start" class="form-input" type="time" step="60" required data-booking-start></div>
              <div><label class="form-label" for="booking-end">End time</label><input id="booking-end" class="form-input" type="time" step="60" required data-booking-end></div>
            </div>
            <fieldset class="booking-day-list"><legend class="form-label">Available days</legend>
              <label><input type="checkbox" data-booking-day="mon"><span>Monday</span></label>
              <label><input type="checkbox" data-booking-day="tue"><span>Tuesday</span></label>
              <label><input type="checkbox" data-booking-day="wed"><span>Wednesday</span></label>
              <label><input type="checkbox" data-booking-day="thu"><span>Thursday</span></label>
              <label><input type="checkbox" data-booking-day="fri"><span>Friday</span></label>
              <label><input type="checkbox" data-booking-day="sat"><span>Saturday</span></label>
              <label><input type="checkbox" data-booking-day="sun"><span>Sunday</span></label>
            </fieldset>
            <label class="form-label" for="booking-contact-email">Booking contact email (private)</label>
            <input id="booking-contact-email" class="form-input" type="email" name="booking_email" maxlength="254" autocomplete="email" placeholder="Leave blank to use your confirmed account email">
            <label class="form-label" for="booking-notes">Booking notice / lead-time note</label><textarea id="booking-notes" class="form-textarea" rows="3" maxlength="1000" data-booking-notes></textarea>
          </fieldset>
        </section>
        <section class="creator-editor-section" id="creator-bio" aria-labelledby="creator-bio-title">
          <h2 id="creator-bio-title" class="account-subheading">Profile Text</h2>
          <label class="form-label" for="creator-tagline">Tagline</label><textarea class="form-textarea" id="creator-tagline" name="tagline" rows="3" maxlength="1000"></textarea>
          <label class="form-label" for="creator-about">About</label><textarea class="form-textarea" id="creator-about" name="about" rows="8" maxlength="20000"></textarea>
          <label class="form-label" for="creator-tags">Tags (comma-separated)</label><input class="form-input" id="creator-tags" name="tags" maxlength="2000">
        </section>
        <section class="creator-editor-section" id="creator-protocol" aria-labelledby="creator-protocol-title">
          <h2 id="creator-protocol-title" class="account-subheading">Boundaries &amp; How to Book</h2>
          <p class="text-muted">These instructions are public when your profile is published. Use the editor toolbar or switch to Markdown for paragraphs, lists and formatting. Leave a field empty to hide its card. Booking instructions do not create reservations or collect payments.</p>
          <label class="form-label" for="creator-boundaries">Hard Limits &amp; Boundaries</label><textarea class="form-textarea" id="creator-boundaries" name="boundaries" rows="6" maxlength="4000"></textarea>
          <label class="form-label" for="creator-booking-instructions">How to Book</label><textarea class="form-textarea" id="creator-booking-instructions" name="booking_instructions" rows="6" maxlength="4000"></textarea>
        </section>
        <section class="creator-editor-section" id="creator-images" aria-labelledby="creator-images-title">
          <h2 id="creator-images-title" class="account-subheading">Photos &amp; Visuals</h2>
          <div class="form-grid-2">
            <div><label class="form-label" for="creator-avatar">Avatar image URL</label><input class="form-input" id="creator-avatar" name="avatar_image" maxlength="2048"><img class="creator-image-preview preview-hidden" data-creator-avatar-preview alt="Avatar preview" loading="lazy"></div>
            <div><label class="form-label" for="creator-banner">Banner image URL</label><input class="form-input" id="creator-banner" name="banner_image" maxlength="2048"><img class="creator-image-preview preview-hidden" data-creator-banner-preview alt="Banner preview" loading="lazy"></div>
          </div>
        </section>
        <section class="creator-editor-section" id="creator-gallery" aria-labelledby="creator-gallery-title">
          <div class="creator-editor-toolbar"><h2 id="creator-gallery-title" class="account-subheading">Gallery Library</h2><button class="btn btn-secondary" type="button" data-gallery-add-photo>Add photo</button></div>
          <p class="text-muted">Choose which published photos appear in the public profile sidebar. Up to four are shown, in the order set here. The Gallery tab keeps all published photos.</p>
          <p class="text-muted" data-gallery-count>0 / 20 photos</p>
          <div data-gallery-editor></div>
        </section>
        <section class="creator-editor-section" id="creator-rates" aria-labelledby="creator-rates-title">
          <div class="creator-editor-toolbar"><h2 id="creator-rates-title" class="account-subheading">Rate Cards &amp; Menus</h2><button class="btn btn-secondary" type="button" data-rate-add-category>Add rate category</button></div>
          <div data-rate-editor></div>
        </section>
        <section class="creator-editor-section" id="creator-toys-wishlist" aria-labelledby="creator-toys-wishlist-title">
          <h2 id="creator-toys-wishlist-title" class="account-subheading">My Toys &amp; Wishlist</h2>
          <div class="profile-collection-editor-section">
            <div class="creator-editor-toolbar"><h3 class="account-subheading">My Toys</h3><button class="btn btn-secondary btn-sm" type="button" data-hardware-add>Add toy / feature</button></div>
            <label class="form-label" for="hardware-title">Card title</label>
            <input id="hardware-title" class="form-input" name="hardware_title" maxlength="100">
            <div data-hardware-editor></div>
          </div>
          <div class="profile-collection-editor-section">
            <div class="creator-editor-toolbar"><h3 class="account-subheading">Wishlist &amp; Tributes</h3><button class="btn btn-secondary btn-sm" type="button" data-wishlist-add>Add wishlist link</button></div>
            <label class="form-label" for="wishlist-title">Card title</label>
            <input id="wishlist-title" class="form-input" name="wishlist_title" maxlength="100">
            <div data-wishlist-editor></div>
          </div>
        </section>
          </div>
        </div>
      </fieldset>
    </form>
    <noscript><p>JavaScript is required to edit your profile.</p></noscript>
  </div>
</main>